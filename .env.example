# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deposit_db

# Prisma connection URL
# For local dev (outside Docker): use localhost
# For Docker Compose: host is 'db'
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/deposit_db?schema=public"

# Redis (local dev — Docker Compose overrides REDIS_HOST to 'redis')
REDIS_HOST=localhost
REDIS_PORT=6379

# API authentication key sent via x-api-key header
API_KEY=dev-api-key

# Webhook URL to call after a deposit is processed
CALLBACK_URL=https://example.com/webhook
